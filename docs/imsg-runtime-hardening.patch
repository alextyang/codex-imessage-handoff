+@Test
+func injectedHelperConstructsCustomEmojiReactionsAtomically() throws {
+  let testFile = URL(fileURLWithPath: #filePath)
+  let repoRoot =
+    testFile
+    .deletingLastPathComponent()
+    .deletingLastPathComponent()
+    .deletingLastPathComponent()
+  let helper = repoRoot.appendingPathComponent("Sources/IMsgHelper/IMsgInjected.m")
+  let source = stripObjectiveCComments(try String(contentsOf: helper, encoding: .utf8))
+  let capabilityBody = try #require(
+    functionBody(named: "customEmojiReactionInitializerAvailable", in: source))
+  let constructorBody = try #require(
+    functionBody(named: "buildCustomEmojiReactionIMMessage", in: source))
+  let reactionBody = try #require(functionBody(named: "handleSendReaction", in: source))
+  let statusBody = try #require(functionBody(named: "handleStatus", in: source))
+
+  #expect(
+    source.contains(
+      "instantMessageWithAssociatedMessageContent:associatedMessageGUID:"
+    ))
+  #expect(source.contains("associatedMessageEmoji:"))
+  #expect(source.contains("messageSummaryInfo:threadIdentifier:"))
+  #expect(capabilityBody.contains("respondsToSelector:selector"))
+  #expect(capabilityBody.contains("signature.numberOfArguments == 9"))
+  #expect(statusBody.contains(#"@"custom_emoji_tapbacks": @(gHasCustomEmojiReaction)"#))
+  #expect(!statusBody.contains(#"@"custom_emoji_tapbacks": @YES"#))
+
+  // Both custom add (2006) and remove (3006) must use the atomic constructor.
+  #expect(constructorBody.contains("associatedMessageType != 2006"))
+  #expect(constructorBody.contains("associatedMessageType != 3006"))
+  #expect(constructorBody.contains("setArgument:&associatedMessageGuid atIndex:3"))
+  #expect(constructorBody.contains("setArgument:&associatedMessageType atIndex:4"))
+  #expect(constructorBody.contains("setArgument:&associatedMessageRange atIndex:5"))
+  #expect(constructorBody.contains("setArgument:&associatedMessageEmoji atIndex:6"))
+
+  // Fail closed unless the returned IMMessage preserves the exact reference,
+  // type, range, and emoji that were passed atomically.
+  #expect(constructorBody.contains("associatedMessageGUID"))
+  #expect(constructorBody.contains("associatedMessageType"))
+  #expect(constructorBody.contains("associatedMessageRange"))
+  #expect(constructorBody.contains("associatedMessageEmoji"))
+  #expect(constructorBody.contains("actualType != associatedMessageType"))
+  #expect(constructorBody.contains("NSEqualRanges(actualRange, associatedMessageRange)"))
+  #expect(constructorBody.contains("isEqualToString:associatedMessageEmoji"))
+
+  #expect(reactionBody.contains("Custom emoji reactions are unavailable"))
+  #expect(reactionBody.contains("buildCustomEmojiReactionIMMessage"))
+  #expect(reactionBody.contains("buildIMMessage(body"))
+}
