+/// Reply polls use the same associated-message initializer as ordinary replies
+/// when the payload-bearing atomic initializer is unavailable. Stamp the Polls
+/// balloon metadata on both the message and its backing item, matching the
+/// proven poll-vote path. Summary metadata is also re-applied where supported;
+/// it was already supplied atomically to buildIMMessage.
+static id buildPollReplyFallbackIMMessage(NSAttributedString *body,
+                                          NSData *payloadData,
+                                          NSDictionary *summaryInfo,
+                                          NSString *threadIdentifier,
+                                          NSString *replyToGUID,
+                                          id parentItem,
+                                          IMsgPollConstructionStage *outConstructionStage) {
+    setPollConstructionStage(outConstructionStage, IMsgPollConstructionStageNone);
+    NSRange associatedRange = NSMakeRange(0, body.length);
+    id result = buildIMMessage(body,
+                               nil,
+                               nil,
+                               threadIdentifier,
+                               parentItem,
+                               replyToGUID,
+                               100,
+                               associatedRange,
+                               summaryInfo,
+                               @[],
+                               NO,
+                               NO);
+    if (!result) {
+        setPollConstructionStage(outConstructionStage,
+                                 IMsgPollConstructionStageFallbackMessageNil);
+        return nil;
+    }
+
+    BOOL balloonStamped = NO;
+    BOOL payloadStamped = NO;
+    NSString *balloonID = pollsBalloonBundleIdentifier();
+    for (id target in messageAndBackingItemTargets(result)) {
+        @try {
+            if ([target respondsToSelector:@selector(setBalloonBundleID:)]) {
+                [target performSelector:@selector(setBalloonBundleID:)
+                             withObject:balloonID];
+                balloonStamped = YES;
+            }
+            if ([target respondsToSelector:@selector(setPayloadData:)]) {
+                [target performSelector:@selector(setPayloadData:)
+                             withObject:payloadData];
+                payloadStamped = YES;
+            }
+            if (summaryInfo
+                && [target respondsToSelector:@selector(setMessageSummaryInfo:)]) {
+                [target performSelector:@selector(setMessageSummaryInfo:)
+                             withObject:summaryInfo];
+            }
+        } @catch (__unused NSException *exception) {}
+    }
+    if (!balloonStamped) {
+        setPollConstructionStage(
+            outConstructionStage,
+            IMsgPollConstructionStageFallbackBalloonSetterUnavailable);
+        return nil;
+    }
+    if (!payloadStamped) {
+        setPollConstructionStage(
+            outConstructionStage,
+            IMsgPollConstructionStageFallbackPayloadSetterUnavailable);
+        return nil;
+    }
+    return result;
+}
