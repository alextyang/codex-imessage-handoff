+/// Custom emoji reactions must carry the emoji atomically. The ordinary
+/// associated-message initializers do not accept `associatedMessageEmoji`,
+/// and setting it after construction is not preserved by IMCore's wrapper.
+static id buildCustomEmojiReactionIMMessage(NSAttributedString *body,
+                                            NSString *associatedMessageGuid,
+                                            long long associatedMessageType,
+                                            NSRange associatedMessageRange,
+                                            NSString *associatedMessageEmoji,
+                                            NSDictionary *summaryInfo,
+                                            NSString *threadIdentifier) {
+    if (!body.length || !associatedMessageGuid.length || !associatedMessageEmoji.length) {
+        return nil;
+    }
+    if (associatedMessageType != 2006 && associatedMessageType != 3006) {
+        return nil;
+    }
+
+    Class messageClass = NSClassFromString(@"IMMessage");
+    SEL selector = customEmojiReactionSelector();
+    if (!gHasCustomEmojiReaction || !messageClass
+        || ![messageClass respondsToSelector:selector]) {
+        return nil;
+    }
+    NSMethodSignature *signature = [messageClass methodSignatureForSelector:selector];
+    if (signature.numberOfArguments != 9) return nil;
+
+    NSInvocation *invocation = [NSInvocation invocationWithMethodSignature:signature];
+    [invocation setSelector:selector];
+    [invocation setTarget:messageClass];
+    [invocation setArgument:&body atIndex:2];
+    [invocation setArgument:&associatedMessageGuid atIndex:3];
+    [invocation setArgument:&associatedMessageType atIndex:4];
+    [invocation setArgument:&associatedMessageRange atIndex:5];
+    [invocation setArgument:&associatedMessageEmoji atIndex:6];
+    [invocation setArgument:&summaryInfo atIndex:7];
+    [invocation setArgument:&threadIdentifier atIndex:8];
+    [invocation retainArguments];
+    id result = invokeReturningObject(invocation);
+    if (!result
+        || ![result respondsToSelector:@selector(associatedMessageGUID)]
+        || ![result respondsToSelector:@selector(associatedMessageType)]
+        || ![result respondsToSelector:@selector(associatedMessageRange)]
+        || ![result respondsToSelector:@selector(associatedMessageEmoji)]) {
+        return nil;
+    }
+
+    NSString *actualGuid = [(IMMessage *)result associatedMessageGUID];
+    long long actualType = [(IMMessage *)result associatedMessageType];
+    NSRange actualRange = [(IMMessage *)result associatedMessageRange];
+    NSString *actualEmoji = [(IMMessage *)result associatedMessageEmoji];
+    if (![actualGuid isEqualToString:associatedMessageGuid]
+        || actualType != associatedMessageType
+        || !NSEqualRanges(actualRange, associatedMessageRange)
+        || ![actualEmoji isEqualToString:associatedMessageEmoji]) {
+        return nil;
+    }
+    return result;
+}
