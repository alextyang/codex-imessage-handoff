+/// Probe the exact constructor shape used by service mirrors: a reply
+/// association (type 100) plus a caller-owned GUID. This constructs an
+/// in-memory message only; it never resolves a chat or dispatches the object.
+/// Merely finding a plain-message GUID initializer is insufficient because
+/// every service mirror carries reply metadata.
+static BOOL clientMessageGUIDReplyConstructorAvailable(void) {
+    @autoreleasepool {
+        @try {
+            NSString *clientMessageGuid = @"00000000-0000-4000-8000-000000000001";
+            NSString *associatedMessageGuid =
+                @"p:0/00000000-0000-4000-8000-000000000002";
+            long long associatedMessageType = 100;
+            NSAttributedString *body = [[NSAttributedString alloc]
+                initWithString:@"imsg capability probe"];
+            NSRange associatedMessageRange = NSMakeRange(0, body.length);
+            id message = buildIMMessage(body,
+                                        nil,
+                                        nil,
+                                        nil,
+                                        nil,
+                                        associatedMessageGuid,
+                                        associatedMessageType,
+                                        associatedMessageRange,
+                                        nil,
+                                        @[],
+                                        NO,
+                                        NO,
+                                        clientMessageGuid);
+            if (!message
+                || ![message respondsToSelector:@selector(guid)]
+                || ![message respondsToSelector:@selector(associatedMessageGUID)]
+                || ![message respondsToSelector:@selector(associatedMessageType)]
+                || ![message respondsToSelector:@selector(associatedMessageRange)]) {
+                return NO;
+            }
+            NSString *actualGuid = [(IMMessage *)message guid];
+            NSString *actualAssociatedGuid =
+                [(IMMessage *)message associatedMessageGUID];
+            long long actualAssociatedType =
+                [(IMMessage *)message associatedMessageType];
+            NSRange actualAssociatedRange =
+                [(IMMessage *)message associatedMessageRange];
+            return [actualGuid isEqualToString:clientMessageGuid]
+                && [actualAssociatedGuid isEqualToString:associatedMessageGuid]
+                && actualAssociatedType == associatedMessageType
+                && NSEqualRanges(actualAssociatedRange, associatedMessageRange);
+        } @catch (NSException *exception) {
+            return NO;
+        }
+    }
+}
