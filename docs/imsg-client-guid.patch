+  public func messageMatchesCallerOwnedSend(
+    guid: String,
+    text: String,
+    chatID: Int64,
+    threadOriginatorGUID: String?
+  ) throws -> Bool {
+    let expectedGUID = guid.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !expectedGUID.isEmpty, chatID > 0,
+      schema.hasThreadOriginatorGUIDColumn
+    else {
+      return false
+    }
+
+    let selection = MessageRowSelection(store: self, includeChatID: true)
+    let sql = """
+      SELECT \(selection.selectList)
+      FROM message m
+      JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
+      LEFT JOIN handle h ON m.handle_id = h.ROWID
+      WHERE m.guid = ?
+        AND cmj.chat_id = ?
+        AND m.is_from_me = 1
+      LIMIT 1
+      """
+    return try withConnection { db in
+      let rows = try db.prepareRowIterator(sql, bindings: [expectedGUID, chatID])
+      guard let row = try rows.failableNext() else { return false }
+      let decoded = try decodeMessageRow(
+        row,
+        columns: selection.columns,
+        fallbackChatID: chatID
+      )
+      let expectedRoot = normalizeAssociatedGUID(
+        threadOriginatorGUID?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+      )
+      let actualRoot = normalizeAssociatedGUID(decoded.threadOriginatorGUID)
+      return decoded.chatID == chatID
+        && decoded.isFromMe
+        && decoded.text == text
+        && actualRoot == expectedRoot
+    }
+  }
