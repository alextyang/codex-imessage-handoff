+static NSString *canonicalClientMessageGuid(id value) {
+    if (![value isKindOfClass:[NSString class]]) return nil;
+    NSString *raw = (NSString *)value;
+    if (raw.length != 36) return nil;
+    NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:raw];
+    NSString *canonical = uuid.UUIDString;
+    if (!canonical.length || ![canonical isEqualToString:raw]) return nil;
+    if ([raw characterAtIndex:14] != '4') return nil;
+    unichar variant = [raw characterAtIndex:19];
+    if (!(variant == '8' || variant == '9' || variant == 'A' || variant == 'B')) return nil;
+    return canonical;
+}
+
+static NSMutableOrderedSet<NSString *> *claimedClientMessageGuids(void) {
+    static NSMutableOrderedSet<NSString *> *claimed;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        claimed = [NSMutableOrderedSet orderedSet];
+    });
+    return claimed;
+}
+
+static BOOL claimClientMessageGuid(NSString *guid) {
+    NSMutableOrderedSet<NSString *> *claimed = claimedClientMessageGuids();
+    @synchronized (claimed) {
+        if ([claimed containsObject:guid]) return NO;
+        [claimed addObject:guid];
+        while (claimed.count > 4096) [claimed removeObjectAtIndex:0];
+        return YES;
+    }
+}
+
+static void releaseClientMessageGuid(NSString *guid) {
+    NSMutableOrderedSet<NSString *> *claimed = claimedClientMessageGuids();
+    @synchronized (claimed) {
+        [claimed removeObject:guid];
+    }
+}
