+  public func messageExists(guid: String) throws -> Bool {
+    let value = guid.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !value.isEmpty else { return false }
+    return try withConnection { db in
+      let rows = try db.prepareRowIterator(
+        "SELECT 1 AS present FROM message WHERE guid = ? LIMIT 1",
+        bindings: [value]
+      )
+      return try rows.failableNext() != nil
+    }
+  }
