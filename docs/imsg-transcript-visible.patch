+/// A transcript-visible reply is self-contained on its IMMessage. It must not
+/// depend on mutable per-chat inline-reply state.
+static BOOL transcriptVisibleReplyMetadataMatches(id message,
+                                                  NSString *selectedMessageGuid,
+                                                  NSString *threadIdentifier,
+                                                  id parentMessage,
+                                                  id parentItem,
+                                                  NSRange associatedRange) {
+    if (!message || !selectedMessageGuid.length || !threadIdentifier.length
+        || !parentMessage || !parentItem) {
+        return NO;
+    }
+    (void)associatedRange;
+    if (![message respondsToSelector:@selector(associatedMessageGUID)]
+        || ![message respondsToSelector:@selector(associatedMessageType)]
+        || ![message respondsToSelector:@selector(_imMessageItem)]
+        || ![message respondsToSelector:@selector(threadIdentifier)]
+        || ![message respondsToSelector:@selector(threadOriginator)]) {
+        return NO;
+    }
+    @try {
+        NSString *messageAssociatedGuid =
+            [message performSelector:@selector(associatedMessageGUID)];
+        long long messageAssociatedType = [(IMMessage *)message associatedMessageType];
+        NSString *messageThreadIdentifier =
+            [message performSelector:@selector(threadIdentifier)];
+        id messageThreadOriginator =
+            [message performSelector:@selector(threadOriginator)];
+        id messageItem = [message performSelector:@selector(_imMessageItem)];
+        if (!messageItem
+            || ![messageItem respondsToSelector:@selector(threadIdentifier)]
+            || ![messageItem respondsToSelector:@selector(threadOriginator)]) {
+            return NO;
+        }
+        NSString *itemThreadIdentifier =
+            [messageItem performSelector:@selector(threadIdentifier)];
+        id itemThreadOriginator =
+            [messageItem performSelector:@selector(threadOriginator)];
+        NSString *itemOriginatorGuid =
+            [itemThreadOriginator respondsToSelector:@selector(guid)]
+                ? [itemThreadOriginator performSelector:@selector(guid)]
+                : nil;
+        NSString *parentItemGuid = [parentItem respondsToSelector:@selector(guid)]
+            ? [parentItem performSelector:@selector(guid)]
+            : nil;
+
+        BOOL associatedGuidClear = messageAssociatedGuid.length == 0;
+        BOOL associatedTypeClear = messageAssociatedType == 0;
+        BOOL messageThreadMatches =
+            [messageThreadIdentifier isEqualToString:threadIdentifier];
+        BOOL messageOriginatorMatches = messageThreadOriginator == parentMessage;
+        BOOL itemThreadMatches =
+            [itemThreadIdentifier isEqualToString:threadIdentifier];
+        BOOL itemOriginatorMatches = itemThreadOriginator == parentItem
+            || (itemOriginatorGuid.length > 0
+                && ([itemOriginatorGuid isEqualToString:selectedMessageGuid]
+                    || [itemOriginatorGuid isEqualToString:parentItemGuid]));
+        return associatedGuidClear
+            && associatedTypeClear
+            && messageThreadMatches
+            && messageOriginatorMatches
+            && itemThreadMatches
+            && itemOriginatorMatches;
+    } @catch (__unused NSException *exception) {
+        return NO;
+    }
+}
