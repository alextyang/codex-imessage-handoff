+static BOOL stampTranscriptVisibleReplyMetadata(id message,
+                                                NSString *selectedMessageGuid,
+                                                NSString *threadIdentifier,
+                                                id parentMessage,
+                                                id parentItem,
+                                                NSRange associatedRange) {
+    if (!parentItem
+        || ![message respondsToSelector:@selector(setThreadIdentifier:)]
+        || ![message respondsToSelector:@selector(setThreadOriginator:)]) {
+        return NO;
+    }
+    @try {
+        [message performSelector:@selector(setThreadIdentifier:)
+                      withObject:threadIdentifier];
+        [message performSelector:@selector(setThreadOriginator:)
+                      withObject:parentMessage];
+    } @catch (__unused NSException *exception) {
+        return NO;
+    }
+    return transcriptVisibleReplyMetadataMatches(message,
+                                                 selectedMessageGuid,
+                                                 threadIdentifier,
+                                                 parentMessage,
+                                                 parentItem,
+                                                 associatedRange);
+}
