+/// Dispatch through IMChat itself so the sending Messages process inserts the
+/// outgoing item into its live transcript. The registry-level dispatch is
+/// reliable for background automation but can persist and deliver a reply
+/// without updating an already-open sender transcript.
+static BOOL dispatchTranscriptVisibleIMMessageInChat(IMChat *chat,
+                                                     id message,
+                                                     NSString *selectedMessageGuid,
+                                                     NSString *threadIdentifier,
+                                                     id parentMessage,
+                                                     id parentItem) {
+    if (!chat || !message || ![chat respondsToSelector:@selector(sendMessage:)]) {
+        return NO;
+    }
+    BOOL isReply = selectedMessageGuid.length > 0;
+    if (isReply
+        && (!threadIdentifier.length || !parentMessage || !parentItem)) {
+        return NO;
+    }
+    if (!isReply) {
+        clearReplyMetadataOnMessage(message);
+    }
+    [chat sendMessage:message];
+    return YES;
+}
