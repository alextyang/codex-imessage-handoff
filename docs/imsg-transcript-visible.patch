+/// Probe the exact self-contained reply object and direct IMChat send surface
+/// used by `send.rich.transcript-visible`. This never resolves a real chat or
+/// dispatches the in-memory probe message.
+static BOOL transcriptVisibleSendAvailable(void) {
+    @autoreleasepool {
+        @try {
+            Class chatClass = NSClassFromString(@"IMChat");
+            Class historyClass = NSClassFromString(@"IMChatHistoryController");
+            Class messageClass = NSClassFromString(@"IMMessage");
+            Class itemClass = NSClassFromString(@"IMMessageItem");
+            if (!chatClass
+                || ![chatClass instancesRespondToSelector:@selector(sendMessage:)]
+                || !historyClass
+                || ![historyClass instancesRespondToSelector:
+                    @selector(loadMessageWithGUID:completionBlock:)]
+                || !messageClass
+                || ![messageClass instancesRespondToSelector:@selector(_imMessageItem)]
+                || !itemClass
+                || ![itemClass instancesRespondToSelector:@selector(_newChatItems)]
+                || ![itemClass instancesRespondToSelector:@selector(threadIdentifier)]
+                || ![itemClass instancesRespondToSelector:@selector(threadOriginator)]
+                || !imCreateThreadIdentifierFn()) {
+                return NO;
+            }
+
+            NSString *selectedMessageGuid =
+                @"p:0/00000000-0000-4000-8000-000000000002";
+            NSString *threadIdentifier =
+                @"p:0/00000000-0000-4000-8000-000000000003";
+            NSAttributedString *parentBody = [[NSAttributedString alloc]
+                initWithString:@"imsg transcript-visible parent probe"];
+            NSRange parentRange = NSMakeRange(0, parentBody.length);
+            id parentMessage = buildIMMessage(parentBody,
+                                              nil,
+                                              nil,
+                                              nil,
+                                              nil,
+                                              nil,
+                                              0,
+                                              parentRange,
+                                              nil,
+                                              @[],
+                                              NO,
+                                              NO,
+                                              selectedMessageGuid);
+            id parentItem = [parentMessage respondsToSelector:@selector(_imMessageItem)]
+                ? [parentMessage performSelector:@selector(_imMessageItem)]
+                : nil;
+            if (!parentMessage || !parentItem) {
+                return NO;
+            }
+            NSAttributedString *body = [[NSAttributedString alloc]
+                initWithString:@"imsg transcript-visible capability probe"];
+            NSRange associatedRange = NSMakeRange(0, body.length);
+            id message = buildIMMessage(body,
+                                        nil,
+                                        nil,
+                                        threadIdentifier,
+                                        parentItem,
+                                        nil,
+                                        0,
+                                        associatedRange,
+                                        nil,
+                                        @[],
+                                        NO,
+                                        NO,
+                                        nil);
+            if (!message || ![message respondsToSelector:@selector(guid)]) {
+                return NO;
+            }
+            return stampTranscriptVisibleReplyMetadata(message,
+                                                       selectedMessageGuid,
+                                                       threadIdentifier,
+                                                       parentMessage,
+                                                       parentItem,
+                                                       associatedRange);
+        } @catch (__unused NSException *exception) {
+            return NO;
+        }
+    }
+}
